  filters_passed:  event_kinds, min_sol_liquidity, quote_mints,
                   require_renounced_authorities, max_top10_holder_concentration,
                   deployer_max_prior_launches
  filters_failed:  []
  risk:            OK   open 8% / 50% cap   daily +4.3% / -10% loss cap
